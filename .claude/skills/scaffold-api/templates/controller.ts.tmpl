const post{{Resource}} = async (req: Request, res: Response) => {
  // Ownership comes from the request context, never from the body.
  const {{resource}} = await {{Resource}}.create({
    ...req.body,
    coach: req.user!._id,
    athlete: req.params.athleteId,
  });

  res.status(201).json({ message: "{{Resource}} created", {{resource}} });
};

const update{{Resource}} = async (req: Request, res: Response) => {
