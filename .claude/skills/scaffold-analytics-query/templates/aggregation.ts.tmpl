// (2) controllers/analyticsController.ts — validate query, scope, run, respond.
// ═════════════════════════════════════════════════════════════════════════════

import type { Request, Response } from "express";
import Joi from "../validation/common.js";
import { Block } from "../model/block.js";
import { {{metric}}Pipeline } from "../utils/analytics/{{metric}}.js";

// validate.js only checks req.body, so query params are validated here.
const {{metric}}QuerySchema = Joi.object({
  from: Joi.date().iso(),
  to: Joi.date().iso().min(Joi.ref("from")),
  lift: Joi.string().valid("squat", "bench", "deadlift"),
});

const run{{Metric}} = async (req: Request, res: Response, athleteId: string, coachId?: string) => {
  const { error, value } = {{metric}}QuerySchema.validate(req.query, { abortEarly: false });
  if (error) {
    return res
      .status(400)
      .json({ message: "Validation failed.", details: error.details.map((d) => d.message) });
  }

  const {{metric}} = await Block.aggregate({{metric}}Pipeline({ athleteId, coachId, ...value }));
  res.status(200).json({ message: "{{Metric}} retrieved", {{metric}} });
};

// Coach: athlete from the path (roster already checked by authorizeCoachForAthleteResource),
// only blocks this coach wrote.
const get{{Metric}} = (req: Request, res: Response) =>
  run{{Metric}}(req, res, req.params.athleteId, String(req.user!._id));

// Athlete: always themselves.
const getAthlete{{Metric}} = (req: Request, res: Response) =>
  run{{Metric}}(req, res, String(req.user!._id));

export { get{{Metric}}, getAthlete{{Metric}} };

